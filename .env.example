# Environment
NODE_ENV=production
ENVIRONMENT=production

# Public Host Domain (Caddy automatic TLS in production, or http://localhost for local)
# For production on Azure VM with HTTPS: DOMAIN=waypoint.knurdz.org
DOMAIN=http://localhost

# Database (PostgreSQL 16)
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint_secret_2026
POSTGRES_DB=waypoint_logistics
DATABASE_URL=postgresql://waypoint:waypoint_secret_2026@localhost:5432/waypoint_logistics?schema=public

# In-Memory Cache (Redis 7.4)
REDIS_URL=redis://localhost:6379

# Internal Python Optimizer
OPTIMIZER_URL=http://localhost:8000

# Authentication & Security
DEFAULT_USER_PASSWORD=Waypoint2026!
JWT_SECRET=waypoint_jwt_super_secure_2026_random_key_change_in_production
NEXTAUTH_URL=http://localhost:3000

# Server Ports
PORT=3000
OPTIMIZER_PORT=8000

# Cartography & Fleet Map (No API Key Required)
# Waypoint uses open-source OpenStreetMap standard raster tiles by default.
# Zero external API keys, registration, or billing required.
# Optional override for custom tile providers:
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Audio & Speech Synthesis (Optional)
# If omitted or empty, Waypoint automatically uses browser neural speech synthesis (window.speechSynthesis)
# ELEVENLABS_API_KEY=
